# VITE_ variables are public. Default: official presidential results persisted in Supabase.
VITE_ELECTION_DATA_SOURCE=tse
VITE_TSE_PROXY_URL=/api/tse/presidential
TSE_ENVIRONMENT=oficial
TSE_DATA_PROVIDER=supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Offline visual fixture: VITE_ELECTION_DATA_SOURCE=mock
# Direct simulation (no persistence): VITE_ELECTION_DATA_SOURCE=tse-sim,
# TSE_ENVIRONMENT=simulado2026 and TSE_DATA_PROVIDER=direct.
# Never add the Supabase secret/service-role key here. The hosted collector owns writes.
