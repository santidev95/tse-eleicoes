{
  "name": "tse",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "test:tse": "tsx scripts/check-tse.ts",
    "test:tse:official": "tsx scripts/check-official.ts",
    "test": "vitest run src server",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pages:types": "wrangler types worker-configuration.d.ts --env-interface Env",
    "pages:build": "npm run build && tsc -p tsconfig.pages.json && wrangler pages functions build --outdir artifacts/pages-function --minify",
    "pages:deploy": "npm run pages:build && wrangler pages deploy dist --project-name eleicoes-dadosabertos --branch main"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20261004.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
